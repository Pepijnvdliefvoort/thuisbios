{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "thuisbios",
      "initial-version": "0.1.0",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "docs",
          "section": "Documentation"
        }
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "apps/tv/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/remote/package.json",
          "jsonpath": "$.version"
        },
        "apps/tv/public/config.xml"
      ]
    }
  }
}
