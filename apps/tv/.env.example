# Optional overrides. Without them the TV page works out the addresses from its own host:
# Jellyfin = http://<host>:8096 and the phone app = http://<host>:4174.
# Jellyfin address when it is not on the same host as the TV page (also: ?server=http://host:8096).
# VITE_JELLYFIN_URL=http://192.168.1.50:8096
# Phone app address put in the QR code (also: ?remote=http://host:4174).
# VITE_REMOTE_URL=http://192.168.1.50:4174
